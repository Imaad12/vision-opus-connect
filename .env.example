# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.
#
# Get these from the Supabase Dashboard for the VINCO project
# (cvonhorkglqizsxdlulp) -> Project Settings -> API.

SUPABASE_PROJECT_ID="cvonhorkglqizsxdlulp"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL="https://cvonhorkglqizsxdlulp.supabase.co"
VITE_SUPABASE_PROJECT_ID="cvonhorkglqizsxdlulp"
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL="https://cvonhorkglqizsxdlulp.supabase.co"

# Vision Contracting backend API (see src/lib/api.ts / the backend repo's
# API_ARCHITECTURE.md). Defaults to http://localhost:8000 if unset.
VITE_API_URL="http://localhost:8000"

# OPTIONAL, desktop build only, NOT required by scripts/check-desktop-env.mjs.
# Desktop now shows the same native VINCO username/password login form as
# web by default (src/components/sign-in-card.tsx) -- nothing reads these
# automatically. They only matter if you want to manually invoke
# src/lib/tauri-dev-auth.ts's signInDesktopDevAccount() from devtools
# during `bun run tauri:dev` as a dev shortcut. Not used by the web build.
VITE_DESKTOP_DEV_EMAIL=""
VITE_DESKTOP_DEV_PASSWORD=""
