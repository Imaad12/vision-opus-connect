# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.
#
# Get these from the Supabase Dashboard for the VINCO project
# (cvonhorkglqizsxdlulp) -> Project Settings -> API.

SUPABASE_PROJECT_ID="cvonhorkglqizsxdlulp"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL="https://cvonhorkglqizsxdlulp.supabase.co"
VITE_SUPABASE_PROJECT_ID="cvonhorkglqizsxdlulp"
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL="https://cvonhorkglqizsxdlulp.supabase.co"

# Vision Contracting backend API (see src/lib/api.ts / the backend repo's
# API_ARCHITECTURE.md). Defaults to http://localhost:8000 if unset.
VITE_API_URL="http://localhost:8000"

# Desktop build only (required by scripts/check-desktop-env.mjs) -- Google
# OAuth is currently parked for the desktop app (see DESKTOP_AUTH_MVP.md),
# so it auto-signs-in as one dedicated internal Supabase account instead
# of showing a login screen. Create that account once via Supabase
# Dashboard -> Authentication -> Users -> Add user (a normal email/
# password user, not a service-role credential), give it a role in the
# existing user_roles table, and put its credentials here. Not used by
# the web build at all.
VITE_DESKTOP_DEV_EMAIL=""
VITE_DESKTOP_DEV_PASSWORD=""
